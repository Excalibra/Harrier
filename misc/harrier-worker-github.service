[Unit]
Description=Harrier Worker GitHub Service
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/opt/Harrier
ExecStart=/usr/local/bin/celery -A app.celerytask.celery worker -l info -Q harriergithub -n harriergithub -c 2 -O fair -f harrier_worker.log

[Install]
WantedBy=multi-user.target

