[Unit]
Description=Harrier Worker Service
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/opt/Harrier
ExecStart=/usr/local/bin/celery -A app.celerytask.celery worker -l info -Q harriertask -n harriertask -c 2 -O fair -f harrier_worker.log

[Install]
WantedBy=multi-user.target

